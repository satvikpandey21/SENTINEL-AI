    {
      "id": 13,
      "title": "Worker / publisher connectivity",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "description": "Actual application transport connectivity; not inferred from traffic.",
      "gridPos": {
        "x": 12,
        "y": 46,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sentinel_worker_connected{service=\"sentinel-event-worker\"} or sentinel_publisher_connected{service=~\"sentinel-.*api\"}",
          "legendFormat": "{{service}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No samples",
