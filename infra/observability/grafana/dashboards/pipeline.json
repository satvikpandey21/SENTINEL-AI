{
  "uid": "sentinel-pipeline",
  "title": "Sentinel AI - Event Pipeline",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "sentinel",
    "operations",
    "provisioned"
  ],
  "links": [
    {
      "title": "System overview",
      "type": "link",
      "url": "/d/sentinel-system",
      "asDropdown": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Operational context",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "options": {
        "mode": "markdown",
        "content": "Broker queue gauges come from RabbitMQ native detailed metrics, filtered to the two Sentinel queues. Persistence counters change after successful PostgreSQL commit; acknowledgements retain their original ordering.\n\n**No samples** means unavailable or no observation yet. Consult scrape and dependency health before interpreting a zero. Operational alerts are separate from security notifications."
      }
    },
    {
      "id": 2,
      "title": "Queue messages ready",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "description": "Broker-reported ready backlog; no message is consumed to observe it.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rabbitmq_detailed_queue_messages_ready",
          "legendFormat": "{{queue}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "Queue messages unacknowledged",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "description": "Broker-reported deliveries awaiting acknowledgement.",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rabbitmq_detailed_queue_messages_unacked",
          "legendFormat": "{{queue}}",
          "range": true
