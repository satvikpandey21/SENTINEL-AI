{
  "uid": "sentinel-streaming",
  "title": "Sentinel AI - Real-Time Streaming",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "sentinel",
    "operations",
    "provisioned"
  ],
  "links": [
    {
      "title": "System overview",
      "type": "link",
      "url": "/d/sentinel-system",
      "asDropdown": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Operational context",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "options": {
        "mode": "markdown",
        "content": "One stream per visible authenticated tab. Server connection attempts cannot distinguish initial connections from browser reconnects. Notification hints remain best effort; REST is authoritative.\n\n**No samples** means unavailable or no observation yet. Consult scrape and dependency health before interpreting a zero. Operational alerts are separate from security notifications."
      }
    },
    {
      "id": 2,
      "title": "Active authenticated WebSockets",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "description": "Accepted connections currently owned by this process; no account/session labels.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sentinel_ws_active{service=\"sentinel-admin-api\"}",
          "legendFormat": "{{service}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "text": {
          "titleSize": 12,
          "valueSize": 28
        }
      }
    },
    {
      "id": 3,
      "title": "WebSocket attempts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "description": "Every attempted upgrade, including rejected authentication and capacity checks.",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(sentinel_ws_attempts_total[5m])",
          "legendFormat": "{{service}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "title": "Accepted and rejected connections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "description": "Rejections include Origin, ticket, authorization, capacity and temporary dependency failures.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(outcome,reason)(rate(sentinel_ws_connections_total[5m]))",
          "legendFormat": "{{outcome}} {{reason}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "title": "Notifications sent",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "description": "Completed ASGI sends of activity frames; not browser acknowledgement or guaranteed delivery.",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(sentinel_notification_sent_total[5m])",
          "legendFormat": "{{service}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Notifications enqueued for clients",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "description": "Successful bounded per-client enqueue attempts; one event may fan out to multiple clients.",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(sentinel_notification_enqueued_total[5m])",
          "legendFormat": "{{service}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Dropped hints / backpressure",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "description": "Actual local drops. Disconnections and crashes can also lose hints without a drop counter.",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(component,reason)(rate(sentinel_notification_dropped_total[5m]))",
          "legendFormat": "{{component}} {{reason}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "Redis notification subscription",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "description": "Current subscriber state; transport failure closes clients for reconciliation.",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sentinel_notification_subscription_up{service=\"sentinel-admin-api\"}",
          "legendFormat": "{{service}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "text": {
          "titleSize": 12,
          "valueSize": 28
        }
      }
    },
    {
      "id": 9,
      "title": "Redis notification errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "description": "Publisher and subscriber error observations.",
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(sentinel_notification_publish_errors_total[5m]) or rate(sentinel_notification_subscription_errors_total[5m])",
          "legendFormat": "{{service}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "title": "Slow-consumer disconnects",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "description": "Clients closed because their bounded outbound queue filled.",
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(sentinel_ws_slow_consumers_total[5m])",
          "legendFormat": "{{service}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "title": "Fan-out p95 duration",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "description": "Time to validate/enqueue a hint for local clients; excludes browser/network delivery.",
      "gridPos": {
        "x": 12,
        "y": 38,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(sentinel_notification_fanout_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  }
}
