{
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assessment Id"
    },
    "classifications": {
      "items": {
        "enum": [
          "possible_brute_force",
          "repeated_authentication_failures",
          "excessive_api_requests",
          "repeated_policy_violations",
          "suspicious_behavioral_deviation",
          "experimental_behavioral_anomaly"
        ],
        "type": "string"
      },
      "maxItems": 6,
      "title": "Classifications",
      "type": "array"
    },
    "committed_at": {
      "format": "date-time",
      "title": "Committed At",
      "type": "string"
    },
    "degraded": {
      "default": false,
      "title": "Degraded",
      "type": "boolean"
    },
    "endpoint": {
      "maxLength": 256,
      "pattern": "^(unmatched|/[a-zA-Z0-9_./{}:~-]*)$",
      "title": "Endpoint",
      "type": "string"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "experimental": {
      "default": false,
      "title": "Experimental",
      "type": "boolean"
    },
    "notification_id": {
      "format": "uuid",
      "title": "Notification Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "risk_score": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Risk Score"
    },
    "rule_ids": {
      "items": {
        "maxLength": 96,
        "pattern": "^[a-zA-Z0-9_.-]+$",
        "type": "string"
      },
      "maxItems": 16,
      "title": "Rule Ids",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "security_action": {
      "anyOf": [
        {
          "enum": [
            "record",
            "rate_limit",
            "temporary_block",
            "deny"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Security Action"
    },
    "service": {
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$",
      "title": "Service",
      "type": "string"
    },
    "severity": {
      "anyOf": [
        {
          "enum": [
            "low",
            "moderate",
            "high",
            "critical"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Severity"
    },
    "status_code": {
      "maximum": 599,
      "minimum": 100,
      "title": "Status Code",
      "type": "integer"
    },
    "type": {
      "enum": [
        "security.event.created",
        "security.decision.created"
      ],
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "notification_id",
    "type",
    "event_id",
    "occurred_at",
    "committed_at",
    "service",
    "endpoint",
    "status_code"
  ],
  "title": "SecurityNotification",
  "type": "object"
}
