# Copy to .env and generate passwords with: python scripts/init_env.py
# This file contains no usable credentials. Never commit .env.
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_USER=sentinel
RABBITMQ_PASSWORD=
# Shared pseudonymization key; generate once and retain across service restarts.
SENTINEL_CLIENT_IDENTITY_KEY=

SENTINEL_ENVIRONMENT=development
SENTINEL_LOG_LEVEL=INFO
SENTINEL_DEPENDENCY_TIMEOUT_SECONDS=3
SENTINEL_DATABASE_POOL_SIZE=5
SENTINEL_DATABASE_MAX_OVERFLOW=5
SENTINEL_TRUSTED_PROXY_CIDRS=[]
# Additional settings are supplied by Compose. For local API processes:
# SENTINEL_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/sentinel
# SENTINEL_REDIS_URL=redis://:PASSWORD@localhost:6379/0
# SENTINEL_RABBITMQ_URL=amqp://USER:PASSWORD@localhost:5672/

# Monitoring is enabled on the demo API by Compose. Admin monitoring remains disabled.
SENTINEL_EVENT_BUFFER_CAPACITY=256
SENTINEL_EVENT_MAX_BYTES=4096
SENTINEL_EVENT_OPERATION_TIMEOUT_SECONDS=2
SENTINEL_EVENT_PUBLISH_ATTEMPTS=5
SENTINEL_EVENT_RETRY_DELAY_SECONDS=0.5
SENTINEL_EVENT_SHUTDOWN_TIMEOUT_SECONDS=5
SENTINEL_BROKER_QUEUE_MAX_MESSAGES=10000
SENTINEL_BROKER_QUEUE_MAX_BYTES=16777216
SENTINEL_WORKER_PREFETCH=16
SENTINEL_WORKER_STORAGE_ATTEMPTS=4
SENTINEL_WORKER_STORAGE_TIMEOUT_SECONDS=3
